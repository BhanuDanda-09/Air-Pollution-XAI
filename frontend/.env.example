# Air Pollution XAI - Frontend Environment Variables

# Backend API Base URL
# Local development:
# VITE_API_URL=http://127.0.0.1:5000
# Production Vercel deployment:
VITE_API_URL=https://air-pollution-xai.onrender.com

# Demo Persona Gating Flag
# Development: set to 'true' to enable demo persona switcher, DEMO MODE banner, and evaluator controls
# Production: set to 'false' (or omit) to ensure all demo code is strictly disabled and tree-shaken
VITE_ENABLE_DEMO_MODE=true
