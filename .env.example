# AirIQ India - Root Environment Configuration Template

# ---------------------------------------------------------------------------
# Backend (Flask / Gunicorn on Render)
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
FLASK_ENV=production
SECRET_KEY=air-pollution-xai-capstone-secret-key-2026
JWT_EXPIRY_SECONDS=3600
ENABLE_DEMO_MODE=false
ALLOWED_ORIGINS=https://air-pollution-xai.vercel.app,http://localhost:3000,http://127.0.0.1:3000
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname (defaults to SQLite: instance/air_pollution.db)
# OPEN_METEO_API_KEY=optional_key_for_commercial_or_high_volume
# OPENAQ_API_KEY=optional_key_here

# ---------------------------------------------------------------------------
# Frontend (React 18 / Vite on Vercel)
# ---------------------------------------------------------------------------
# In local dev: http://127.0.0.1:5000 | In production: https://air-pollution-xai.onrender.com
VITE_API_URL=https://air-pollution-xai.onrender.com

# Demo Persona Gating Flag:
# Development default: 'true' (enables role switcher, DEMO MODE banner, and evaluator controls)
# Production default:  'false' (disables all demo code, banners, switchers, and manual key overrides)
VITE_ENABLE_DEMO_MODE=true
