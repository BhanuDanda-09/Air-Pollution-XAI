# Air Pollution XAI - Backend Environment Variables
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
FLASK_ENV=production

# Security & RBAC Configuration
SECRET_KEY=air-pollution-xai-capstone-secret-key-2026
JWT_EXPIRY_SECONDS=3600
ENABLE_DEMO_MODE=false

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=https://air-pollution-xai.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Persistence & Database (defaults to SQLite: instance/air_pollution.db)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Optional External API Keys
# OPEN_METEO_API_KEY=your_optional_open_meteo_key_here
# OPENAQ_API_KEY=your_optional_openaq_api_key_here
